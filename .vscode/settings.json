{
  "files.autoSave": "afterDelay",
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "material-icon-theme",

  "material-icon-theme.folders.associations": {
    "Mod_01_Bases": "core",
    "Mod_02_Desarrollo_Humano": "messages",
    "Mod_03_POO": "class",
    "PSeInt": "tools",
    "Ejercicios": "test"
  },

  "material-icon-theme.files.associations": {
    "INDICE_GENERAL.md": "toc",
    "Clase_1.md": "changelog",
    "Clase_2.md": "changelog",
    "Clase_3.md": "changelog",
    "Clase_4.md": "changelog",
    "Clase_5.md": "changelog",
    "Clase_6.md": "changelog",
    "Clase_7.md": "changelog",
    "Clase_8.md": "changelog",
    "Clase_9.md": "changelog",
    "Clase_10.md": "changelog",
    "Clase_11.md": "changelog",
    "Clase_12.md": "changelog",
    "Clase_13.md": "changelog",
    "Clase_14.md": "changelog",
    "Clase_15.md": "changelog",
    "Clase_16.md": "changelog",
    "Clase_17.md": "changelog",
    "Clase_18.md": "changelog",
    "Clase_19.md": "changelog",
    "Clase_20.md": "changelog",
    "Clase_21.md": "changelog",
    "Clase_22.md": "changelog",
    "Clase_23.md": "changelog",
  },

  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  "python.analysis.typeCheckingMode": "standard",

  // ==================== CONFIGURACIONES GENERALES ====================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.detectIndentation": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.inlineSuggest.enabled": true,
  "files.trimTrailingWhitespace": true,

  // ==================== PYTHON ====================
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },

  // ==================== WEB (HTML, CSS, JavaScript, JSON) ====================
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ==================== SQL / SQLite ====================
  "[sql]": {
    "editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc",
    "editor.formatOnSave": true
  },
  "sql-formatter.dialect": "sqlite",
  "sql-formatter.keywordCase": "upper",
  "sql-formatter.dataTypeCase": "upper",
  "sql-formatter.indent": "    ",

  "sqlite.recordsPerPage": 100,
  "sqlite.logLevel": "INFO",

  "files.associations": {
    "*.sql": "sql"
  },

  // ==================== JAVA ====================
  "[java]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "redhat.java"
  },
   "java.format.settings.url": "${workspaceFolder}/.vscode/GoogleStyle.xml",
   "java.format.settings.profile": "GoogleStyle",
   "java.project.resourceFilters": [
     "node_modules",
     ".git",
     "\\.docx$",
     "\\.doc$",
     "\\.pdf$",
     "\\.pptx$",
     "\\.zip$"
   ],

  // ==================== MARKDOWN ====================
  "[markdown]": {
    "editor.formatOnSave": true // true activo el formateo
  },

  // ==================== LINTERS ====================
  "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.markdownlint": "explicit"
  },

  "redhat.telemetry.enabled": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "java": true
  }
}