# ==================== PYTHON ====================
# Basura de caché/compilación de Python, se regenera sola al ejecutar código.
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
.venv/
*.egg-info/

# ==================== JAVA ====================
# Archivos compilados por el JDK, se regeneran al compilar. Nunca hay que subirlos.
*.class
*.jar
*.war
target/
bin/
out/

# ==================== BASES DE DATOS ====================
# NOTA: los .db NO se ignoran a propósito, son datos de ejemplo/semilla
# que sirven como guía y se quieren conservar en el repo.

# ==================== SISTEMA / EDITOR ====================
.DS_Store
Thumbs.db
*.log 


# archivo temporal
claude.md