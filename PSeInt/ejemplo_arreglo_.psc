Algoritmo ejemplo_arreglo_
	Definir array Como Entero
	Dimension array[5]
	Para i = 0 Hasta 4 Hacer
		Escribir "Ingrese un número: "
		Leer array[i]
	FinPara
	Escribir "Presiona una letra cualquiera para continuar"
	Leer esperar
	Para i = 0 Hasta 4 Hacer
		Escribir "Posición ",i," lista ", array[i]
	FinPara	
FinAlgoritmo
