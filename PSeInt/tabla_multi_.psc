Algoritmo tabla_multi_
	Definir n Como Entero
	Mientras Verdadero
		Escribir 'Escriba el número de la tabla que quieres'
		Leer n
		Para i<-1 Hasta 10 Con Paso 1 Hacer
			Escribir n, ' * ', i, ' = ', n*i
		FinPara
		
		Escribir ""
		Escribir "========================"
		Escribir ""
	FinMientras
	

FinAlgoritmo
